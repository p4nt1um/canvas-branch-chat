# ============================================================
# Canvas Branch Chat - 环境变量配置模板
# 
# 使用方法：
#   1. 复制此文件为 .env：
#      cp .env.example .env
#   2. 填入你的 API Key 和 Base URL
#   3. 将 .env 放在插件目录：
#      {vault}/.obsidian/plugins/canvas-branch-chat/.env
#   4. 在插件设置中，API Key 环境变量填对应变量名即可
#      （如 DEEPSEEK_API_KEY）
#
# 命名约定：
#   变量名以 _API_KEY 结尾时，对应的 Base URL 变量
#   自动取 _BASE_URL 结尾的同前缀变量。
#   例：DEEPSEEK_API_KEY → DEEPSEEK_BASE_URL
# ============================================================

# --- DeepSeek（默认） ---
DEEPSEEK_API_KEY=sk-placeholder
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# --- OpenAI（备用） ---
# OPENAI_API_KEY=sk-placeholder
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# --- 自定义服务商示例 ---
# MY_CUSTOM_API_KEY=*** 
# MY_CUSTOM_BASE_URL=https://my-api.example.com/v1/chat/completions
